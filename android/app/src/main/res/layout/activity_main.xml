<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🤖 AgentTool"
                android:textColor="@color/color_text"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvConnectionStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="● Disconnected"
                android:textColor="@color/color_error"
                android:textSize="13sp"
                android:background="@drawable/bg_pill"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp" />
        </LinearLayout>

        <!-- Subtitle -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Autonomous Mobile Agent bridge for Gemma LLM. Tracks screen elements &amp; navigates phone directly."
            android:textColor="@color/color_text_secondary"
            android:textSize="14sp"
            android:layout_marginBottom="20dp" />

        <!-- Server Config Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Backend Server WebSocket"
                android:textColor="@color/color_text"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/etServerUrl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="ws://127.0.0.1:8000/ws/device/agent-mobile (USB)"
                android:textColor="@color/color_text"
                android:textColorHint="@color/color_text_secondary"
                android:background="@drawable/bg_field"
                android:padding="12dp"
                android:textSize="14sp"
                android:inputType="textUri"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/btnConnect"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Connect to Gemma Agent" />
        </LinearLayout>

        <!-- Permissions Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Required Permissions"
                android:textColor="@color/color_text"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <!-- 1. Accessibility -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="10dp">

                <TextView
                    android:id="@+id/tvAccessibilityStatus"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="1. Accessibility Service (Screen Track)"
                    android:textColor="@color/color_text"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btnEnableAccessibility"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Enable"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- 2. Overlay -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="10dp">

                <TextView
                    android:id="@+id/tvOverlayStatus"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="2. Floating Overlay (Draw over apps)"
                    android:textColor="@color/color_text"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btnEnableOverlay"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Enable"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- 3. Phone Call & Audio -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvPhoneStatus"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="3. Phone, Contacts &amp; Audio Permissions"
                    android:textColor="@color/color_text"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btnGrantPermissions"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Grant"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Phone Dialer & Contact Search Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📞 Phone Dialer &amp; Contact Search"
                android:textColor="@color/color_text"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Search your contact list or enter any number to open your mobile dialer."
                android:textColor="@color/color_text_secondary"
                android:textSize="12sp"
                android:layout_marginBottom="10dp" />

            <EditText
                android:id="@+id/etTargetInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Enter contact name or phone number..."
                android:textColor="@color/color_text"
                android:textColorHint="@color/color_text_secondary"
                android:background="@drawable/bg_field"
                android:padding="12dp"
                android:textSize="14sp"
                android:inputType="text"
                android:layout_marginBottom="12dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnDialMobile"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="📞 Open Dialer"
                    android:layout_marginEnd="6dp" />

                <Button
                style="@style/Widget.AgentTool.Button.Secondary"
                    android:id="@+id/btnSearchContact"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="🔍 Search Contact"
                    android:layout_marginStart="6dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Knowledge Search & Gemma Reframing Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🔎 Knowledge Tools &amp; Local Gemma"
                android:textColor="@color/color_text"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Calls Wikipedia, DuckDuckGo, arXiv, or PubMed without opening phone browser. Gemma reframes the extracted info."
                android:textColor="@color/color_text_secondary"
                android:textSize="12sp"
                android:layout_marginBottom="10dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Select Knowledge Tool Source:"
                android:textColor="@color/color_text_secondary"
                android:textSize="12sp"
                android:layout_marginBottom="4dp" />

            <Spinner
                android:id="@+id/spnKnowledgeSource"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_field"
                android:padding="10dp"
                android:layout_marginBottom="10dp" />

            <EditText
                android:id="@+id/etKnowledgeQuery"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Ask or search (e.g. how to on developer mode, machine learning)..."
                android:textColor="@color/color_text"
                android:textColorHint="@color/color_text_secondary"
                android:background="@drawable/bg_field"
                android:padding="12dp"
                android:textSize="14sp"
                android:inputType="text"
                android:layout_marginBottom="10dp" />

            <Button
                android:id="@+id/btnSearchKnowledge"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="⚡ Search Tool &amp; Reframe with Gemma"
                android:layout_marginBottom="12dp" />

            <!-- Search Details & Reframed Result -->
            <LinearLayout
                android:id="@+id/layoutSearchResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_tint"
                android:padding="12dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvToolSiteStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/color_primary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:text="🛠️ Tool: -"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:id="@+id/tvInfoTakenPreview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/color_text_secondary"
                    android:textSize="11sp"
                    android:text="📄 Info Fetched: -"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/color_success"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:text="🤖 Local Gemma Reframed Answer:"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/tvReframedAnswer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/color_text"
                    android:textSize="13sp"
                    android:lineSpacingExtra="3dp"
                    android:text="Answer will appear here..." />
            </LinearLayout>
        </LinearLayout>

        <!-- Actions Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Agent Actions"
                android:textColor="@color/color_text"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/btnToggleFloatingBubble"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🔮 Start Floating Agent Bubble"
                android:layout_marginBottom="8dp" />

            <Button
                style="@style/Widget.AgentTool.Button.Secondary"
                android:id="@+id/btnTestDumpScreen"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📋 Dump Screen UI Elements" />
        </LinearLayout>

        <!-- Logs Box -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Agent Activity Log"
            android:textColor="@color/color_text_secondary"
            android:textSize="13sp"
            android:layout_marginBottom="6dp" />

        <TextView
            android:id="@+id/tvLogs"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:background="@drawable/bg_log"
            android:textColor="@color/color_text_secondary"
            android:fontFamily="monospace"
            android:textSize="11sp"
            android:padding="12dp"
            android:scrollbars="vertical"
            android:text="[Ready] Open AgentTool on PC and connect.\n" />

    </LinearLayout>
</ScrollView>
